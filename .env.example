# Which model drives discovery runs. Replay never calls a model at all.
# Default provider is anthropic:
ANTHROPIC_API_KEY=
TELLER_MODEL=claude-opus-5

# Or any OpenAI-compatible endpoint, including a local one that costs nothing:
#   teller discover ... --provider ollama --model qwen2.5:7b
# TELLER_PROVIDER=ollama
# TELLER_MODEL=qwen2.5:7b
# Hosted free tiers work the same way; set the matching key and pick a model id:
# GEMINI_API_KEY=      # --provider gemini
# GROQ_API_KEY=        # --provider groq
# OPENROUTER_API_KEY=  # --provider openrouter

# Demo credentials for the meridian sample app. The surface logs in with these
# before the model gets control; the model never sees or types them.
MERIDIAN_URL=http://127.0.0.1:5057
MERIDIAN_USER=operator1
MERIDIAN_PASS=teller!23
